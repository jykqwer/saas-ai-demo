# 复制为 .env 并填入你的真实 Key 即可接入大模型；不填则运行演示模式。
# DeepSeek 官方示例：
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_SECONDS=0.5

# 图片 + 文本自动路由到阿里云百炼 Qwen3.7-Plus（OpenAI 兼容接口）
QWEN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VISION_MODEL=qwen3.7-plus

# 其他兼容服务商（OpenAI）：
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# RAG 知识库（backend/knowledge_base/*.md）
RAG_ENABLED=true
RAG_TOP_K=3
RAG_MIN_SCORE=1.0
RAG_CANDIDATE_K=24
RAG_VECTOR_WEIGHT=0.4

# 网络搜索（Tavily Search API；从 https://app.tavily.com 获取 Key）
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=tavily  # tavily | wikipedia | auto
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxx
WEB_SEARCH_MAX_RESULTS=5

# 演示用户服务：普通用户每天 10 次，注册后由 superuser 审批。
AUTH_ENABLED=true
USER_DAILY_QUESTION_LIMIT=10
QUOTA_TIMEZONE=Asia/Shanghai
AUTH_SESSION_TTL_HOURS=24
BOOTSTRAP_SUPERUSER_USERNAME=demo-admin
BOOTSTRAP_SUPERUSER_PASSWORD=请替换为至少8位强密码

# 产品文案（可选）
SAAS_PRODUCT_NAME="云枢 CloudHub"
SAAS_COMPANY_NAME="云枢科技"
