# 数据库凭据 Secret 示例：真实值绝不提交 Git，用命令行创建：
#
#   kubectl -n saas-ai create secret generic postgres-credentials \
#     --from-literal=POSTGRES_DB=saasdb \
#     --from-literal=POSTGRES_USER=saasuser \
#     --from-literal=POSTGRES_PASSWORD="$(openssl rand -hex 24)" \
#     --dry-run=client -o yaml | kubectl apply -f -
#
# DATABASE_URL 必须是单行值，指向 postgres-service；含特殊字符的密码需 URL 编码。
# 同时创建 LLM Secret（见 secret.yaml.example）：
#
#   kubectl -n saas-ai create secret generic llm-credentials \
#     --from-literal=LLM_API_KEY="sk-xxxx" \
#     --from-literal=LLM_BASE_URL="https://api.deepseek.com" \
#     --from-literal=LLM_MODEL="deepseek-chat" \
#     --dry-run=client -o yaml | kubectl apply -f -
apiVersion: v1
kind: Secret
metadata:
  name: postgres-credentials
  namespace: saas-ai
type: Opaque
stringData:
  POSTGRES_DB: saasdb
  POSTGRES_USER: saasuser
  # 示例密码；生产环境请用 openssl rand 生成并保留为机密。
  POSTGRES_PASSWORD: change-me
  # 需与上面的凭据保持一致，并做 URL 编码（特殊字符时）。
  DATABASE_URL: postgresql+psycopg://saasuser:change-me@postgres-service.saas-ai.svc.cluster.local:5432/saasdb
