# LLM API Key Secret 示例。真实 Key 绝不提交到 Git：
# 复制为 postgres-secret 命名（或直接内联），并用如下命令生成：
#
#   kubectl -n saas-ai-demo create secret generic llm-credentials \
#     --from-literal=LLM_API_KEY="sk-xxxx" \
#     --from-literal=LLM_BASE_URL="https://api.deepseek.com" \
#     --from-literal=LLM_MODEL="deepseek-chat" \
#     --from-literal=TAVILY_API_KEY="tvly-xxxx" \
#     --from-literal=BOOTSTRAP_SUPERUSER_PASSWORD="replace-with-strong-password" \
#     --dry-run=client -o yaml | kubectl apply -f -
#
# 若手写此文件，请确保 base64 值正确，并不要把本文件提交到仓库。
apiVersion: v1
kind: Secret
metadata:
  name: llm-credentials
  namespace: saas-ai-demo
type: Opaque
stringData:
  # 留空则后端进入演示模式（无需 Key 也能跑通）。
  LLM_API_KEY: ""
  LLM_BASE_URL: "https://api.deepseek.com"
  LLM_MODEL: "deepseek-chat"
  TAVILY_API_KEY: ""
  BOOTSTRAP_SUPERUSER_PASSWORD: "replace-with-strong-password"
